rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function under(mb) { return request.resource == null || request.resource.size < mb * 1024 * 1024; }

    // Who belongs to a group or club lives in Firestore. Storage rules can
    // read those documents directly, so a file is only ever handed to a
    // member. Before this, any signed-in account could read, overwrite, or
    // delete any group's or club's file if it knew the path.
    function groupDoc(code) { return firestore.get(/databases/(default)/documents/studyGroups/$(code)); }
    function groupExists(code) { return firestore.exists(/databases/(default)/documents/studyGroups/$(code)); }
    function groupMember(code) { return signedIn() && groupExists(code) && request.auth.uid in groupDoc(code).data.memberUids; }
    function groupOwner(code) { return signedIn() && groupExists(code) && groupDoc(code).data.createdBy == request.auth.uid; }
    function orgDoc(code) { return firestore.get(/databases/(default)/documents/orgs/$(code)); }
    function orgExists(code) { return firestore.exists(/databases/(default)/documents/orgs/$(code)); }
    function orgMember(code) { return signedIn() && orgExists(code) && request.auth.uid in orgDoc(code).data.memberUids; }
    function orgOfficer(code) { return signedIn() && orgExists(code) && request.auth.uid in orgDoc(code).data.officerUids; }
    // The app stamps uploadedBy on every file it stores (storageFileMetadata
    // in js/utils.js), so the person who shared a file can take it back.
    function uploadedByMe() { return resource != null && resource.metadata != null && resource.metadata.uploadedBy == request.auth.uid; }

    // Personal file attachments (on assignments). Only the owner, capped so
    // a free account can't fill the bucket.
    match /users/{uid}/attachments/{fileId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && under(25);
    }

    // The original syllabus a student uploaded, kept under the class it was
    // read into (see keepSyllabusFile in js/syllabus.js). Strictly private to
    // the one account: a syllabus carries a professor's email, office number
    // and phone. 25MB matches the app's own limit for keeping one.
    match /users/{uid}/syllabi/{fileId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && under(25);
    }

    // Study group files, current format: uploaded when a member shares a file
    // (see addCloudGroupItem). Members only, capped at 10MB to match the app.
    // A file is replaced or removed only by whoever shared it, or the owner.
    //
    // Uploading over a file that already exists is judged by `create`, not
    // `update` — `update` only covers changing a file's metadata. So the
    // create rule itself has to refuse a replacement by anyone else, or any
    // member could swap out another member's shared file. The app never
    // needs to: every share gets a fresh id in its path.
    match /studyGroups/{code}/files/{fileId} {
      allow read: if groupMember(code);
      allow create: if groupMember(code) && under(10)
        && (resource == null || groupOwner(code) || uploadedByMe());
      allow update: if under(10) && (groupOwner(code) || (groupMember(code) && uploadedByMe()));
      allow delete: if groupOwner(code) || (groupMember(code) && uploadedByMe());
    }

    // Club & team files: officers share them from the Files tab (see
    // saveOrgFile in orgs.js); every member can open them.
    match /orgs/{code}/files/{fileId} {
      allow read: if orgMember(code);
      allow create, update: if orgOfficer(code) && under(10);
      allow delete: if orgOfficer(code);
    }

    // First-version study group files. Existing links keep working; nothing
    // new is written here and nothing can be replaced.
    match /studyGroups/{groupId}/{fileId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}

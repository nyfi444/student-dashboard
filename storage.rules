rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Personal file attachments (on assignments) — only the owner can
    // read/write their own. Files live here instead of embedded as base64
    // inside the Firestore planner doc, since a single photo or PDF can
    // easily exceed Firestore's 1MB-per-document cap on its own — no amount
    // of splitting documents fixes that, only actual blob storage does.
    match /users/{uid}/attachments/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Study group files, current format: uploaded when someone shares a file
    // (see addCloudGroupItem). Signed-in only, capped at 10MB to match the
    // app's limit. Members open them through the download URL stored in the
    // group's items subcollection, which firestore.rules keeps members-only.
    match /studyGroups/{code}/files/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // Club & team files: officers share them from the Files tab (see
    // saveOrgFile in orgs.js). Same shape and 10MB cap as study group files;
    // members open them through the download URL kept in the club's doc.
    match /orgs/{code}/files/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // First-version study group files. Kept so existing links keep working.
    match /studyGroups/{groupId}/{fileId} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';
// Published by .github/workflows/deploy-rules.yml: to semester-hq-staging
// from every branch after the rules tests pass, and to semester-hq from main.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's planner data — only the owner can read/write their own.
    match /planners/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Notebook notes live in their own document per note (not inline in
      // the parent planner doc above) specifically so one person's growing
      // collection of notes can never push the whole planner past
      // Firestore's 1MB-per-document cap. Same owner-only rule.
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // The person's own list of the forms they have answered, one entry
      // per form. It exists so "delete my account" can find every answer
      // they ever sent, including to clubs they never joined: the form
      // rules below refuse an answer that doesn't arrive with its entry.
      //
      // An entry for an ANONYMOUS form is written by the Worker (it holds
      // the id of the answer, which carries no name). The owner can read it
      // and nothing else: if they could remove it, they could answer an
      // anonymous vote again and again.
      match /formAnswers/{key} {
        function mineToKeep() { return request.auth != null && request.auth.uid == uid; }
        allow read: if mineToKeep();
        allow create: if mineToKeep() && request.resource.data.get('anon', false) != true;
        allow update: if mineToKeep() && request.resource.data.get('anon', false) != true
          && resource.data.get('anon', false) != true;
        allow delete: if mineToKeep() && resource.data.get('anon', false) != true;
      }
    }

    // Forms (clubs and study groups both have them; see js/spaces/formcore.js).
    // What any stored form has to look like, whoever is allowed to write it.
    function validForm(d, formId) {
      return d.id == formId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.questions is list && d.questions.size() <= 40
        && d.status in ['draft', 'open', 'closed']
        && d.audience in ['members', 'link']
        && d.collectEmail is bool
        && d.allowEdit is bool
        && (d.closesAt == null || d.closesAt is number)
        && d.createdBy is string
        && d.get('anonymous', false) is bool
        && d.get('review', false) is bool;
    }
    // An anonymous form takes its answers through the Worker only, so no
    // answer to it is ever filed under anybody's uid.
    function formIsNamed(form) { return form.get('anonymous', false) != true; }
    // Whether a form is anonymous is settled by the time it leaves draft.
    // Switching it later would either put names next to answers people
    // gave believing there would be none, or hide who sent the ones that
    // were named.
    function formKeepsItsPromise(after, before) {
      return before.status == 'draft'
        || after.get('anonymous', false) == before.get('anonymous', false);
    }
    // Accepted, waitlisted or declined: a note the people running the form
    // keep about an answer. Never readable by the person it is about.
    function validFormMark(d) {
      return d.keys().hasOnly(['status', 'by', 'at'])
        && d.status in ['accepted', 'waitlisted', 'declined']
        && d.by == request.auth.uid
        && d.at is number;
    }
    function formIsOpen(form) {
      return form.status == 'open' && (form.closesAt == null || request.time.toMillis() < form.closesAt);
    }
    // One answer. It is filed under the sender's own uid, carries the email
    // address they signed in with (never one they typed) and only when the
    // form asks for it, and says truthfully whether they are a member.
    function validFormAnswer(d, uid, form, isMember) {
      return d.keys().hasOnly(['uid', 'name', 'email', 'member', 'answers', 'at', 'updatedAt'])
        && d.uid == uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.member == isMember
        && d.answers is map && d.answers.size() <= 40
        && d.at is number && d.updatedAt is number
        && (form.collectEmail == true
            ? ('email' in request.auth.token && d.email == request.auth.token.email)
            : !('email' in d));
    }

    // A group's or club's public preview: what someone holding the code
    // sees before joining (js/spaces/invite.js). Only these fields, only
    // this size, and the member count has to be the real one, so nobody can
    // dress a space up as bigger than it is. Faces, names, events, files
    // and chat stay in the members-only document.
    function validPreview(d, parent, docId) {
      return docId == 'preview'
        && d.keys().hasOnly(['v', 'name', 'description', 'color', 'courseLabel', 'kind', 'school', 'memberCount', 'next', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && (!('description' in d) || (d.description is string && d.description.size() <= 200))
        && (!('color' in d) || (d.color is string && d.color.size() <= 9))
        && (!('courseLabel' in d) || (d.courseLabel is string && d.courseLabel.size() <= 80))
        && (!('kind' in d) || (d.kind is string && d.kind.size() <= 20))
        && (!('school' in d) || (d.school is string && d.school.size() <= 120))
        && d.memberCount == parent.memberUids.size()
        && (!('next' in d) || d.next == null
            || (d.next is map && d.next.keys().hasOnly(['title', 'date', 'start'])
                && d.next.title is string && d.next.title.size() <= 120
                && d.next.date is string && d.next.date.size() <= 10
                && (!('start' in d.next) || (d.next.start is string && d.next.start.size() <= 5))))
        && d.updatedAt is number;
    }

    // Study groups. The 6-character code is the doc id and doubles as the
    // invite: anyone signed in who has the code can read the group's public
    // preview (public/preview, below) and add themselves, unless the owner
    // blocked them. The group itself is members-only, and there's no `list`,
    // so nobody can browse or download groups. Until Oct 2026 anyone with the
    // code could read the whole group; the first version of these rules let
    // any signed-in user read, overwrite, or delete every group.
    match /studyGroups/{code} {
      function signedIn() { return request.auth != null; }
      function isMember(data) { return signedIn() && ('memberUids' in data) && request.auth.uid in data.memberUids; }
      function groupData() { return get(/databases/$(database)/documents/studyGroups/$(code)).data; }

      allow get: if isMember(resource.data)
        || (signedIn() && !('memberUids' in resource.data) && resource.data.createdBy == request.auth.uid);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // Members can edit sessions, tasks, availability, etc. Only the owner
        // can remove someone else or hand off ownership; anyone can leave.
        // Only the owner blocks or unblocks someone.
        (isMember(resource.data) && (
          resource.data.createdBy == request.auth.uid
          || (request.resource.data.memberUids.hasAll(resource.data.memberUids.removeAll([request.auth.uid]))
              && request.resource.data.createdBy == resource.data.createdBy
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked']))
        ))
        // Joining with the code: may only add yourself, nothing else, and
        // not after the owner removed you with "Block from rejoining".
        || (!(request.auth.uid in resource.data.memberUids)
            && !(request.auth.uid in resource.data.get('blocked', {}))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'people', 'members', 'updatedAt'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([request.auth.uid]))
        // First-version groups had no member list at all. Their creator
        // converts them to the current format on first open (see
        // ensureGroupMembership); nobody else may touch them.
        || (!('memberUids' in resource.data) && resource.data.createdBy == request.auth.uid)
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // The public preview. Members keep it current; the Worker's daily job
      // refreshes every one with the service account.
      match /public/{docId} {
        function groupPath() { return /databases/$(database)/documents/studyGroups/$(code); }
        allow get: if signedIn();
        allow list: if false;
        allow create, update: if isMember(groupData()) && validPreview(request.resource.data, groupData(), docId);
        allow delete: if signedIn() && (!exists(groupPath()) || groupData().createdBy == request.auth.uid);
      }

      // Shared notes, decks, files, links.
      match /items/{itemId} {
        allow read: if isMember(groupData());
        allow create: if isMember(groupData()) && request.resource.data.sharedByUid == request.auth.uid;
        allow delete: if isMember(groupData())
          && (resource.data.sharedByUid == request.auth.uid || groupData().createdBy == request.auth.uid);
        allow update: if false;
      }

      // Group chat. You can only post as yourself; the owner can remove any message.
      match /messages/{messageId} {
        allow read: if isMember(groupData());
        allow create: if isMember(groupData())
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
        allow delete: if isMember(groupData())
          && (resource.data.uid == request.auth.uid || groupData().createdBy == request.auth.uid);
        allow update: if false;
      }

      // Forms. Any member can make one. Whoever made it, and the group's
      // owner, run it: edit, close, delete, read the answers. Members see
      // the group's forms; someone outside the group can open one only
      // while it is open and set to "anyone with the link".
      match /forms/{formId} {
        function runsForm(form) {
          return isMember(groupData())
            && (form.createdBy == request.auth.uid || groupData().createdBy == request.auth.uid);
        }
        allow get: if isMember(groupData())
          || (signedIn() && resource.data.audience == 'link' && resource.data.status == 'open');
        allow list: if isMember(groupData());
        allow create: if isMember(groupData())
          && validForm(request.resource.data, formId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if runsForm(resource.data)
          && validForm(request.resource.data, formId)
          && request.resource.data.createdBy == resource.data.createdBy
          && formKeepsItsPromise(request.resource.data, resource.data);
        allow delete: if runsForm(resource.data);

        // Answers: one per person, filed under their uid. Only the sender
        // and whoever runs the form can read one.
        match /responses/{uid} {
          function theForm() { return get(/databases/$(database)/documents/studyGroups/$(code)/forms/$(formId)).data; }
          function mine() { return signedIn() && request.auth.uid == uid; }
          function mayAnswer() {
            return mine() && formIsOpen(theForm())
              && (theForm().audience == 'link' || isMember(groupData()));
          }
          function recorded() {
            return existsAfter(/databases/$(database)/documents/planners/$(uid)/formAnswers/$('studyGroups_' + code + '_' + formId));
          }
          allow get: if mine() || runsForm(theForm());
          allow list: if runsForm(theForm());
          allow create: if mayAnswer() && formIsNamed(theForm())
            && validFormAnswer(request.resource.data, uid, theForm(), isMember(groupData()))
            && recorded();
          allow update: if mayAnswer() && formIsNamed(theForm())
            && theForm().allowEdit == true
            && validFormAnswer(request.resource.data, uid, theForm(), isMember(groupData()))
            && request.resource.data.at == resource.data.at;
          allow delete: if mine() || runsForm(theForm());
        }

        // Accepted, waitlisted, declined: only whoever runs the form.
        match /marks/{uid} {
          function markedForm() { return get(/databases/$(database)/documents/studyGroups/$(code)/forms/$(formId)).data; }
          allow read, delete: if runsForm(markedForm());
          allow create, update: if runsForm(markedForm()) && validFormMark(request.resource.data);
        }
      }
    }

    // Shared classes. The 6-character code is the invite: anyone signed in
    // who has it can read the class (course code, name, instructor, class
    // times, and assignment titles and dates, nothing personal). Classes the
    // sharer marked "listed" can also be found by school and course code.
    // Only the person who shared a class can change or delete it.
    // Notes several people edit together (js/notebook-shared.js). Who can
    // open and edit one: the people on it (editorUids: its owner and anyone
    // who joined with its link), plus everyone currently in the study group
    // or club it is shared with, so leaving that group or club takes the
    // note away again. Only the owner changes who it's shared with, and the
    // owner can take people off but never put anyone on: people join
    // themselves, with the link.
    match /sharedNotes/{noteId} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function inGroup(code) {
        return code is string && code != ''
          && exists(/databases/$(database)/documents/studyGroups/$(code))
          && me() in get(/databases/$(database)/documents/studyGroups/$(code)).data.get('memberUids', []);
      }
      function inOrg(code) {
        return code is string && code != ''
          && exists(/databases/$(database)/documents/orgs/$(code))
          && me() in get(/databases/$(database)/documents/orgs/$(code)).data.get('memberUids', []);
      }
      function canEdit(d) { return signedIn() && (me() in d.editorUids || inGroup(d.groupCode) || inOrg(d.orgCode)); }
      function noteDoc() { return get(/databases/$(database)/documents/sharedNotes/$(noteId)).data; }
      function validNote(d) {
        return d.keys().hasOnly(['title', 'content', 'ownerUid', 'editorUids', 'people', 'groupCode', 'orgCode', 'joinKey', 'createdAt', 'updatedAt', 'updatedBy', 'rev'])
          && d.keys().hasAll(['title', 'content', 'ownerUid', 'editorUids', 'people', 'groupCode', 'orgCode', 'joinKey'])
          && d.title is string && d.title.size() <= 200
          && d.content is string && d.content.size() <= 900000
          && d.ownerUid is string
          && d.editorUids is list && d.editorUids.size() <= 200
          && d.people is map && d.people.size() <= 200
          && d.groupCode is string && d.groupCode.size() <= 40
          && d.orgCode is string && d.orgCode.size() <= 40
          && d.joinKey is string && (d.joinKey == '' || (d.joinKey.size() >= 20 && d.joinKey.size() <= 64));
      }
      function onlyMyName() { return request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([me()]); }
      function sharedOnlyWhereIAm(field, check) {
        return request.resource.data[field] == resource.data[field] || request.resource.data[field] == '' || check;
      }

      allow get: if canEdit(resource.data);
      // Listing works for the three questions the app asks: the notes I am
      // on, and the notes shared with one of my groups or clubs.
      allow list: if signedIn() && (me() in resource.data.editorUids || inGroup(resource.data.groupCode) || inOrg(resource.data.orgCode));
      // The id goes into the app's markup (the notes list), so it is letters
      // and digits only.
      allow create: if signedIn() && validNote(request.resource.data)
        && noteId.matches('^[A-Za-z0-9]{10,40}$')
        && request.resource.data.ownerUid == me()
        && request.resource.data.editorUids == [me()]
        && (request.resource.data.groupCode == '' || inGroup(request.resource.data.groupCode))
        && (request.resource.data.orgCode == '' || inOrg(request.resource.data.orgCode));
      allow update: if signedIn() && validNote(request.resource.data) && (
        // The owner: sharing, the link, taking people off. Stays the owner
        // and stays on it, and shares only with a group or club they're in.
        (resource.data.ownerUid == me()
          && request.resource.data.ownerUid == me()
          && me() in request.resource.data.editorUids
          && resource.data.editorUids.concat([me()]).hasAll(request.resource.data.editorUids)
          && sharedOnlyWhereIAm('groupCode', inGroup(request.resource.data.groupCode))
          && sharedOnlyWhereIAm('orgCode', inOrg(request.resource.data.orgCode)))
        // Anyone who can edit it: the writing, the title, their own name,
        // or taking themselves off it.
        || (canEdit(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'updatedAt', 'updatedBy', 'rev', 'people', 'editorUids'])
          && (request.resource.data.editorUids == resource.data.editorUids
            || (resource.data.ownerUid != me() && request.resource.data.editorUids == resource.data.editorUids.removeAll([me()])))
          && onlyMyName())
        // Joining with the link: adds only yourself, and only with a join
        // record that holds the note's current key (written in the same batch).
        || (!(me() in resource.data.editorUids)
          && resource.data.joinKey != ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editorUids', 'people'])
          && request.resource.data.editorUids == resource.data.editorUids.concat([me()])
          && existsAfter(/databases/$(database)/documents/sharedNotes/$(noteId)/joins/$(me()))
          && getAfter(/databases/$(database)/documents/sharedNotes/$(noteId)/joins/$(me())).data.key == resource.data.joinKey
          && onlyMyName())
      );
      allow delete: if signedIn() && resource.data.ownerUid == me();

      // The key someone joined with. Only right while it matches the note's
      // link; turning the link off or making a new one stops old links.
      match /joins/{uid} {
        allow read: if signedIn() && uid == me();
        allow create, update: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['key', 'at'])
          && request.resource.data.key is string
          && noteDoc().joinKey != ''
          && request.resource.data.key == noteDoc().joinKey;
        allow delete: if signedIn() && (uid == me() || noteDoc().ownerUid == me());
      }

      // Who has the note open, and where their cursor is.
      match /presence/{uid} {
        allow read: if canEdit(noteDoc());
        allow create, update: if signedIn() && uid == me() && canEdit(noteDoc())
          && request.resource.data.keys().hasOnly(['name', 'at', 'caret', 'color'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.at is number
          && request.resource.data.caret is int && request.resource.data.caret >= -1
          && (!('color' in request.resource.data) || (request.resource.data.color is string && request.resource.data.color.size() <= 9));
        allow delete: if signedIn() && (uid == me() || noteDoc().ownerUid == me());
      }
    }

    match /classes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.listed == true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == code;
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.code == resource.data.code;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Who joined, for the classmate count. You can only add or remove yourself.
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Clubs & teams. Like study groups, the 6-character code is the invite:
    // anyone signed in with the code can read the club's public preview and
    // add themselves, unless an officer blocked them. The club itself is
    // members-only.
    // Officers (officerUids) run it: events, announcements, files, members,
    // details. Only the founder (createdBy) changes who's an officer or hands
    // off the org, and the founder can never be removed. Regular members can
    // only RSVP for themselves, update their own name and title, mark the
    // chat's latest message as theirs, or leave.
    match /orgs/{code} {
      function orgSignedIn() { return request.auth != null; }
      function orgChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function isOrgMember() { return orgSignedIn() && request.auth.uid in resource.data.memberUids; }
      function isOrgOfficer() { return orgSignedIn() && request.auth.uid in resource.data.officerUids; }
      function isOrgFounder() { return orgSignedIn() && resource.data.createdBy == request.auth.uid; }
      // Removing only yourself from a list.
      function removesOnlyMe(field) {
        return request.resource.data[field].hasAll(resource.data[field].removeAll([request.auth.uid]))
          && !(request.auth.uid in request.resource.data[field])
          && request.resource.data[field].size() == resource.data[field].size() - 1;
      }

      // A member's own entry in people: only their name, title and join
      // date, and they can never mark their own title as reviewed. That is
      // the founder's check that "President" really is the president.
      function ownEntryOk() {
        let me = request.auth.uid;
        let before = resource.data.get('people', {}).get(me, {});
        let after = request.resource.data.get('people', {});
        return !(me in after)
          || (after[me].keys().hasOnly(['name', 'title', 'joinedAt', 'reviewed'])
              && (after[me].get('reviewed', false) != true
                  || (before.get('reviewed', false) == true && after[me].get('title', '') == before.get('title', ''))));
      }

      allow get: if isOrgMember();
      allow list: if false;

      allow create: if orgSignedIn()
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.officerUids == [request.auth.uid];

      allow update: if orgSignedIn() && request.resource.data.code == resource.data.code && (
        // Officers
        (isOrgOfficer()
          && request.resource.data.memberUids is list
          && request.resource.data.officerUids is list
          && request.resource.data.createdBy in request.resource.data.memberUids
          && request.resource.data.createdBy in request.resource.data.officerUids
          // Officers remove people; they never add anyone. People join
          // themselves, with the code.
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && (isOrgFounder()
              || (!orgChanged().hasAny(['createdBy'])
                  && (!orgChanged().hasAny(['officerUids']) || removesOnlyMe('officerUids')))))
        // Members
        || (isOrgMember() && !isOrgOfficer()
          && orgChanged().hasOnly(['rsvp', 'people', 'memberUids', 'lastMessage', 'updatedAt'])
          && (!orgChanged().hasAny(['rsvp']) || request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([request.auth.uid]))
          && (!orgChanged().hasAny(['people']) || (request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([request.auth.uid]) && ownEntryOk()))
          && (!orgChanged().hasAny(['memberUids']) || removesOnlyMe('memberUids'))
          && (!orgChanged().hasAny(['lastMessage']) || request.resource.data.lastMessage.uid == request.auth.uid))
        // Joining with the code: add only yourself, arrive unreviewed, and
        // not after an officer removed you with "Block from rejoining".
        || (!(request.auth.uid in resource.data.memberUids)
          && !(request.auth.uid in resource.data.get('blocked', {}))
          && orgChanged().hasOnly(['memberUids', 'people', 'updatedAt'])
          && request.resource.data.people[request.auth.uid].keys().hasOnly(['name', 'joinedAt', 'title'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if isOrgFounder();

      // The public preview. Officers keep it current; the Worker's daily job
      // refreshes every one with the service account.
      match /public/{docId} {
        function previewOrgPath() { return /databases/$(database)/documents/orgs/$(code); }
        function previewOrg() { return get(previewOrgPath()).data; }
        allow get: if request.auth != null;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid in previewOrg().officerUids
          && validPreview(request.resource.data, previewOrg(), docId);
        allow delete: if request.auth != null && (!exists(previewOrgPath()) || previewOrg().createdBy == request.auth.uid);
      }

      // Club chat. Members read and post as themselves; officers can remove
      // any message. Same shape as study group chat.
      match /messages/{messageId} {
        function orgDoc() { return get(/databases/$(database)/documents/orgs/$(code)).data; }
        allow read: if request.auth != null && request.auth.uid in orgDoc().memberUids;
        allow create: if request.auth != null && request.auth.uid in orgDoc().memberUids
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
        allow delete: if request.auth != null && request.auth.uid in orgDoc().memberUids
          && (resource.data.uid == request.auth.uid || request.auth.uid in orgDoc().officerUids);
        allow update: if false;
      }

      // Forms. Officers write and run them. Members see the club's forms;
      // someone outside the club can open one only while it is open and
      // set to "anyone with the link" (an interest form, an application).
      match /forms/{formId} {
        function formOrg() { return get(/databases/$(database)/documents/orgs/$(code)).data; }
        function formMember() { return request.auth != null && request.auth.uid in formOrg().memberUids; }
        function formOfficer() { return request.auth != null && request.auth.uid in formOrg().officerUids; }

        allow get: if formMember()
          || (request.auth != null && resource.data.audience == 'link' && resource.data.status == 'open');
        allow list: if formMember();
        allow create: if formOfficer()
          && validForm(request.resource.data, formId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if formOfficer()
          && validForm(request.resource.data, formId)
          && request.resource.data.createdBy == resource.data.createdBy
          && formKeepsItsPromise(request.resource.data, resource.data);
        allow delete: if formOfficer();

        // Answers: one per person, filed under their uid. Only the sender
        // and the club's officers can read one; other members cannot.
        match /responses/{uid} {
          function theForm() { return get(/databases/$(database)/documents/orgs/$(code)/forms/$(formId)).data; }
          function mine() { return request.auth != null && request.auth.uid == uid; }
          function mayAnswer() {
            return mine() && formIsOpen(theForm())
              && (theForm().audience == 'link' || formMember());
          }
          function recorded() {
            return existsAfter(/databases/$(database)/documents/planners/$(uid)/formAnswers/$('orgs_' + code + '_' + formId));
          }
          allow get: if mine() || formOfficer();
          allow list: if formOfficer();
          allow create: if mayAnswer() && formIsNamed(theForm())
            && validFormAnswer(request.resource.data, uid, theForm(), formMember())
            && recorded();
          allow update: if mayAnswer() && formIsNamed(theForm())
            && theForm().allowEdit == true
            && validFormAnswer(request.resource.data, uid, theForm(), formMember())
            && request.resource.data.at == resource.data.at;
          allow delete: if mine() || formOfficer();
        }

        // Accepted, waitlisted, declined: officers only. The person an
        // answer belongs to cannot read what was decided about it here.
        match /marks/{uid} {
          allow read, delete: if formOfficer();
          allow create, update: if formOfficer() && validFormMark(request.resource.data);
        }
      }
    }

    // Left over from the removed notification feature: this used to hold push
    // subscriptions and a reminder schedule. Nothing writes it any more, and
    // the app no longer reads it. Owners keep delete access so an existing doc
    // can still be cleaned up (and "delete my account" removes it server-side);
    // nobody can create a new one.
    match /push/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Licenses are the source of truth for who has paid. Only the backend
    // Worker (using a service account, which bypasses these rules entirely)
    // is allowed to write one — the client can only read its own, so a user
    // can't grant themselves access by editing Firestore from devtools.
    match /licenses/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Internal linking table for purchases made before sign-up (marketing
    // site checkout, keyed by email). Never read or written by the client
    // directly — only the Worker's /claim-license route touches this.
    match /licensesByEmail/{emailId} {
      allow read, write: if false;
    }

    // Contact/feedback form submissions from the marketing site. Never read
    // or written by the client directly — only the Worker's
    // /contact-message route writes these (with its own rate limiting and
    // validation), so this is server-only the same way licenses are.
    match /feedback/{id} {
      allow read, write: if false;
    }

    // Client-side crash reports from the app and marketing site. Never read
    // or written by the client directly — only the Worker's /log-error
    // route writes these, same server-only pattern as feedback.
    match /errors/{id} {
      allow read, write: if false;
    }

    // Marketing-site CTA clicks (Log in, Try it free, Upgrade, Subscribe,
    // checkout errors) — lets us see which buttons people actually use.
    // Never read or written by the client directly — only the Worker's
    // /track-event route writes these, same server-only pattern as feedback.
    match /events/{id} {
      allow read, write: if false;
    }

    // Group plans: a club, team, or department buying Semester HQ for its
    // members (see the Worker's /group/* routes). Seats, members, and invite
    // codes decide who gets a paid plan, so nothing here is client-writable,
    // and member lists aren't client-readable either: the admin page reads
    // them through the Worker, which checks that you're one of the plan's
    // admins first. Unmatched paths already default to deny; these are
    // spelled out so the collections are documented where the rest are.
    match /groupPlans/{planId} {
      allow read, write: if false;
      match /members/{uid} {
        allow read, write: if false;
      }
    }
    match /groupInvites/{code} {
      allow read, write: if false;
    }

    // Customer emails (worker/src/onboarding.js): where each paying student
    // is in the welcome-and-tips sequence (plus three yes/no setup flags),
    // their tips on/off choice, and a log of every email sent so none goes
    // twice. The Worker's service account is the only reader and writer;
    // the app changes the setting and reports progress through the Worker.
    match /emailOnboarding/{emailId} {
      allow read, write: if false;
    }
    match /emailPrefs/{emailId} {
      allow read, write: if false;
    }
    match /emailLog/{logId} {
      allow read, write: if false;
    }

    // The Worker's own bookkeeping for the Business OS: the daily ledger,
    // the overnight business events and their state, and AI cost per day.
    // Counts and business facts only, server-only like everything above.
    match /bizLedger/{day} {
      allow read, write: if false;
    }
    match /bizEvents/{id} {
      allow read, write: if false;
    }
    match /bizState/{id} {
      allow read, write: if false;
    }
    match /aiUsage/{day} {
      allow read, write: if false;
    }

    // Nyla's private Business OS (semester-hq-dashboard repo) syncs one
    // document per owner account. Not part of the student app: only her own
    // verified Google accounts can read or write, and only their own doc.
    match /semesterhq_biz/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['nnylabrown111@gmail.com', 'semesterhq@gmail.com'];
    }
  }
}

{
  "name": "Semester HQ",
  "short_name": "Semester HQ",
  "description": "Everything your semester needs. One HQ.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#141414",
  "icons": [
    {
      "src": "rosewater-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "rosewater-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "rosewater-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "rosewater-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Quick capture",
      "url": "/?capture=1",
      "icons": [
        {
          "src": "rosewater-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Start a focus session",
      "url": "/?open=timer",
      "icons": [
        {
          "src": "rosewater-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}